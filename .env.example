# Copy to .env and fill in. Every value here is read via core/src/settings.py —
# nothing in the codebase reads os.environ directly.

# ── Postgres ────────────────────────────────────────────────────────────────
# Raw asyncpg DSN. NOT SQLAlchemy's postgresql+asyncpg:// form — asyncpg cannot
# parse it.
POSTGRES_DSN=postgresql://app:app@postgres:5432/recruiter
POSTGRES_POOL_MIN=2
POSTGRES_POOL_MAX=10

# ── Neo4j (skill graph + vector retrieval) ──────────────────────────────────
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=recruiterpass

# ── Redis (arq broker + embedding cache) ────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Host ports (UNIQUE per machine — avoid collisions with other apps) ───────
# Only the HOST-published side; the in-network service ports are unchanged, so
# the DSNs above (postgres:5432, neo4j:7687, redis:6379, api:8000) still work.
# docker-compose.yml reads these as ${X_PORT:-<stock>}, so leaving them unset
# falls back to the stock ports (5432/6379/7474/7687/8000/5000). This machine
# runs many projects' containers, so the stack ships on a unique 29xxx block;
# scripts/quickstart.ps1 writes these into .env automatically.
API_PORT=29800
FRONTEND_PORT=29500
POSTGRES_PORT=29432
REDIS_PORT=29379
NEO4J_HTTP_PORT=29474
NEO4J_BOLT_PORT=29687

# ── Inference — OpenAI-compatible Ollama. OFFLINE ONLY (never a cloud host). ─
# Inference does NOT run on the app box. It runs on the dedicated GPU host
# **aria-gb10**, reached over Tailscale. aria-gb10 has both models pulled +
# calibrated: gpt-oss:20b (generation) + nomic-embed-text (embeddings).
#
# LLM_BASE_URL is aria-gb10's Tailscale IP (its tailnet address — the container
# resolves the raw IP reliably; the `aria-gb10` hostname does NOT resolve inside
# Docker). YOUR BOX MUST BE JOINED TO THE TAILNET. Default shipped below:
#     LLM_BASE_URL=http://100.88.247.106:11434/v1   # aria-gb10 over Tailscale
#     LLM_TIMEOUT_S=900     # gpt-oss:20b ~23.5 tok/s; 4096 tok ≈ 174s solo,
#                           # ~520-700s with max_jobs=4 sharing one GPU.
#
# ONLY if you run your OWN Ollama on the app box instead (not this team's setup):
#     LLM_BASE_URL=http://host.docker.internal:11434/v1
#     LLM_TIMEOUT_S=120     # and: ollama pull gpt-oss:20b nomic-embed-text
#
# scripts/quickstart.ps1 verifies both models are present at LLM_BASE_URL before
# it declares the stack ready, and prints exactly what to fix if not.
LLM_BASE_URL=http://100.88.247.106:11434/v1
LLM_TIMEOUT_S=900
LLM_MODEL_GENERATION=gpt-oss:20b
LLM_MODEL_EMBEDDING=nomic-embed-text
# CONTRACT: must equal the Neo4j vector-index `vector.dimensions`. Changing the
# embedding model means changing this AND rebuilding the vector indexes.
LLM_EMBEDDING_DIM=768

# ── Storage — filesystem BlobStore (no MinIO/S3) ────────────────────────────
STORAGE_DIR=/data

# ── Privacy ─────────────────────────────────────────────────────────────────
# REQUIRED. pgcrypto key for candidate PII (name/email/phone/cover letter),
# loaded into the app.pii_key GUC. Generate 32 random bytes, base64-encoded:
#   openssl rand -base64 32
# Losing this key makes every encrypted column unrecoverable. Never commit it.
PII_KEY=
# REQUIRED (ADR-008). Salt folded into every NON-VOCAB skill's Neo4j graph
# key (a closed-vocabulary skill's key stays plain cleartext; anything else
# is salted-hashed so a candidate's own name, mis-extracted as a "skill",
# can never land in the graph as cleartext or an embedding). Generate the
# same way as PII_KEY:
#   openssl rand -base64 32
# Rotating this value requires re-projecting the whole graph (every job and
# résumé re-parsed) to reconnect REQUIRES/HAS_SKILL edges under the new keys.
SKILL_HASH_SALT=
# Blind review (name/email/phone redacted in the viewer) is ON by default.
BLIND_REVIEW_DEFAULT=true

# ── API auth (FU-4: keyed roles) ────────────────────────────────────────────
# Auth is DISABLED (fail-open, single-operator local-dev ONLY) iff ALL FOUR
# are left empty — every caller resolves Role.ADMIN with no credential at
# all. Auth is ENABLED iff ANY is set: the presented X-API-Key must match
# exactly one of these (constant-time). Generate each the same way as
# PII_KEY/SKILL_HASH_SALT (openssl rand -base64 32) and give every role a
# DISTINCT value — two roles sharing one key silently collapses them into the
# more privileged of the two (validate_startup_auth_config refuses to boot on
# that). REQUIRED (at least one) whenever CAS_ENABLED=true — booting CAS on
# with all four empty is refused at startup (security finding
# fix/auth-boundary-fails-open, F1b): resolve_role would otherwise grant
# admin authority to every caller regardless of credential.
API_KEY_ADMIN=
# The Flask BFF (frontend service) presents this ONE key for every browser it
# serves — required for the UI to keep working once auth is enabled.
API_KEY_RECRUITER=
API_KEY_HIRING_MANAGER=
API_KEY_AUDITOR=

# ── Gates ───────────────────────────────────────────────────────────────────
COVERAGE_THRESHOLD=80

# ── Flask viewer ────────────────────────────────────────────────────────────
API_BASE_URL=http://api:8000
FLASK_SECRET_KEY=change-me

# ── CAS single sign-on (ADR-019) ────────────────────────────────────────────
# These were referenced throughout the docs and the compose comments for weeks
# and defined NOWHERE, so "set CAS_ENABLED=true in .env" was advice that could
# not work: `docker-compose.yml` did not name the variable, so it never reached
# a container. Every `docker compose up` therefore booted with auth DISABLED —
# including the audit-log viewer, reachable with no login — while the comments
# said otherwise. Fixed by `env_file: [.env]` on the api and frontend services;
# these keys are now the real switch. `scripts/doctor.sh` fails on an
# auth-disabled stack that holds data, because nothing else could see it.
#
# CAS_ENABLED must be a real boolean. An EMPTY value is not "false" — it is a
# pydantic ValidationError that stops the container from starting.
#
# ON by default: this is what gets handed to testers, and every gated feature
# (the auditor role, the audited reveal, row scoping) is meaningless without it.
# Turn it OFF only to run scripts/smoke.sh, which cannot complete a CAS
# handshake — and turn it back on before handing the stack to anyone.
# NOTE: with CAS on, at least one API_KEY_* must be set or the API refuses to
# boot by design (validate_startup_auth_config). quickstart.ps1 generates all four.
CAS_ENABLED=true
# Where the browser is sent to sign in, and where CAS sends it back.
CAS_SERVER_URL=https://cas.sfu.ca/cas
# The API's own externally-reachable base URL (CAS validates against this).
CAS_SERVICE_BASE_URL=http://localhost:29800
# The Flask viewer's base URL, used to bounce the browser back after login.
CAS_FRONTEND_BASE_URL=http://localhost:29500
# The one account bootstrapped as admin on first login (ADR-019 §10a).
DEFAULT_ADMIN_CAS_USERNAME=asalah
